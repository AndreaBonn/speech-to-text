# All optional; defaults shown.
SBOBINA_WHISPER_MODEL=large-v3
SBOBINA_WHISPER_MODEL_CPU=large-v3-turbo
SBOBINA_DEVICE=auto
SBOBINA_COMPUTE_TYPE=auto
SBOBINA_CPU_THREADS=0
SBOBINA_LANGUAGE=it
SBOBINA_BEAM_SIZE=5
SBOBINA_CONDITION_ON_PREVIOUS_TEXT=false
SBOBINA_VAD_FILTER=false
SBOBINA_UNCERTAIN_THRESHOLD=0.7
SBOBINA_PARAGRAPH_GAP_S=2.0
SBOBINA_PARAGRAPH_MAX_S=120.0

# Motore LLM: "local" (Ollama, default) o "api" (catena cloud + Ollama in coda)
# SBOBINA_LLM_ENGINE=local
# Catena ordinata provider+modello, JSON. Esempio:
# SBOBINA_LLM_CHAIN=[{"provider":"groq","model":"llama-3.3-70b"}]
# SBOBINA_LLM_OLLAMA_FALLBACK=true
# SBOBINA_CLOUD_TIMEOUT_S=60.0
# Chiavi provider cloud (SecretStr, non loggate, mai scritte in job.json)
# SBOBINA_GROQ_API_KEY=
# SBOBINA_GEMINI_API_KEY=
# SBOBINA_OPENAI_API_KEY=
# SBOBINA_ANTHROPIC_API_KEY=
# SBOBINA_ASSEMBLYAI_API_KEY=
